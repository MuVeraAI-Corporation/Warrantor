{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantor.dev/schemas/research/candidate-record-v2.schema.json",
  "title": "Warrantor Research Candidate Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "authors",
    "publisher",
    "date",
    "sourceClass",
    "canonicalUrl",
    "freeAccess",
    "windowClass",
    "reviewState",
    "products",
    "capabilities",
    "claimRefs",
    "relevance",
    "limitations",
    "nextAction"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 3 },
    "authors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "publisher": { "type": "string", "minLength": 1 },
    "date": { "type": ["string", "null"] },
    "sourceClass": { "$ref": "https://warrantor.dev/schemas/research/source-record-v2.schema.json#/$defs/sourceClass" },
    "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "freeAccess": { "enum": ["verified", "appears-free", "registration", "unverified", "failed"] },
    "windowClass": { "enum": ["main-2024-2026", "older-foundation", "date-unresolved"] },
    "reviewState": { "enum": ["discovered", "metadata-verified", "content-opened", "full-text-reviewed", "reject-likely"] },
    "products": { "type": "array", "items": { "enum": ["W1", "W2", "W3", "W4", "W5", "W6"] }, "uniqueItems": true },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "claimRefs": { "type": "array", "items": { "pattern": "^CLM-[0-9]{4}$" }, "uniqueItems": true },
    "relevance": { "type": "string", "minLength": 20 },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "nextAction": { "enum": ["full-review", "metadata-check", "version-check", "artifact-check", "compare-features", "legal-status-check", "reject"] }
  }
}

