{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantor.dev/schemas/research/rejection-record-v2.schema.json",
  "title": "Warrantor Research Rejection Record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "canonicalUrl",
    "decisionDate",
    "decision",
    "reasonCodes",
    "rationale",
    "allowedUse",
    "claimRefs",
    "reconsiderationTriggers"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 3 },
    "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "decisionDate": { "type": "string", "format": "date" },
    "decision": { "enum": ["reject", "duplicate", "superseded", "inaccessible", "retracted"] },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "insufficient-authority",
          "insufficient-technical-depth",
          "unverified-claims",
          "promotional",
          "unaccountable-authorship",
          "duplicate-work",
          "superseded-version",
          "free-full-text-unavailable",
          "broken-or-unstable-access",
          "retracted-or-withdrawn",
          "out-of-scope",
          "below-quality-threshold"
        ]
      }
    },
    "rationale": { "type": "string", "minLength": 40 },
    "allowedUse": { "type": "string", "minLength": 20 },
    "claimRefs": { "type": "array", "items": { "pattern": "^CLM-[0-9]{4}$" }, "uniqueItems": true },
    "reconsiderationTriggers": { "type": "array", "items": { "type": "string" } }
  }
}
