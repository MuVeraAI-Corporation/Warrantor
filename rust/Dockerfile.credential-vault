# credential-vault (Rust) — agent-scoped credential brokering (15-min TTL,
# <1s revocation). Library + CLI; the container runs the `credential-vault` binary.
#
# Build context MUST be the `rust/` workspace root (see docker-compose.yml):
#   docker build -f Dockerfile.credential-vault .

# ── Stage 1: build the release binary ────────────────────────────────────────
FROM rust:1.80-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .
RUN cargo build --release --bin credential-vault

# ── Stage 2: minimal runtime image ───────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libssl3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/credential-vault /usr/local/bin/credential-vault

ENTRYPOINT ["credential-vault"]
# Default to `status` so an unconfigured `docker run` reports service state.
CMD ["status"]

EXPOSE 8447
