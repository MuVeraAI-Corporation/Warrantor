# credential-vault (Rust) — agent-scoped credential brokering (15-min TTL,
# <1s revocation). Library + CLI; the container runs the `credential-vault` binary.
#
# Build context MUST be the `rust/` workspace root (see docker-compose.yml):
#   docker build -f Dockerfile.credential-vault .

# ── Stage 1: build the release binary ────────────────────────────────────────
# Pinned to a current toolchain rather than 1.80: dependencies in the lockfile now carry
# manifests 1.80 cannot parse, so the build failed with 'failed to parse manifest'. A base
# image pin is a floor that silently expires as the dependency tree moves.
FROM rust:1.85-slim AS builder

# protobuf-compiler gives us protoc; libprotobuf-dev supplies the WELL-KNOWN types
# (/usr/include/google/protobuf/*.proto). Our protos import
# google/protobuf/timestamp.proto, and on Debian those .proto files ship in the -dev
# package, not with the compiler binary -- installing only protobuf-compiler gets you
# a protoc that cannot resolve its own standard imports.
RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev protobuf-compiler libprotobuf-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .
RUN cargo build --release --bin credential-vault

# ── Stage 2: minimal runtime image ───────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libssl3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/credential-vault /usr/local/bin/credential-vault

ENTRYPOINT ["credential-vault"]
# Default to `status` so an unconfigured `docker run` reports service state.
CMD ["status"]

EXPOSE 8447
