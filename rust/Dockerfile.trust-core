# trust-core (Rust) — the single authoritative implementation of every security
# invariant in AumOS. The container runs the `trust-core` CLI binary.
#
# Build context MUST be the `rust/` workspace root (see docker-compose.yml):
#   docker build -f Dockerfile.trust-core .
#
# The CLI is a one-shot tool (key-gen / sign / verify / notarize); it does not
# listen on a port in v1.0. The compose healthcheck runs `trust-core key-gen`
# to confirm the binary is present and functional. Port 8440 is EXPOSEd for
# forward-compatibility with the v2 HTTP surface.

# ── Stage 1: build the release binary ────────────────────────────────────────
# Pinned to a current toolchain rather than 1.80: dependencies in the lockfile now carry
# manifests 1.80 cannot parse, so the build failed with 'failed to parse manifest'. A base
# image pin is a floor that silently expires as the dependency tree moves.
FROM rust:1.85-slim AS builder

# Build dependencies for the crates that link against OpenSSL (ring/reqwest
# transitive). `pkg-config` and `libssl-dev` are required to compile them.
# protobuf-compiler is required: warrantor-api's build script regenerates types from
# the vendored protos on every build, and prost-build shells out to protoc.
RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the entire workspace so Cargo can resolve path dependencies
# (warrantor-api, etc.) and the shared Cargo.lock.
COPY . .

# Build only the trust-core binary. `--bin` avoids compiling every example/bin
# in the workspace and keeps the layer cache effective.
RUN cargo build --release --bin trust-core

# ── Stage 2: minimal runtime image ───────────────────────────────────────────
FROM debian:bookworm-slim

# libssl3 is required at runtime by the OpenSSL-linked crates; ca-certificates
# is required for any TLS verification (e.g. future KMS / Rekor calls).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libssl3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/trust-core /usr/local/bin/trust-core

ENTRYPOINT ["trust-core"]
# Default to `key-gen` so `docker run aumos/trust-core` produces useful output
# and the compose healthcheck (`trust-core key-gen`) stays valid.
CMD ["key-gen"]

EXPOSE 8440
