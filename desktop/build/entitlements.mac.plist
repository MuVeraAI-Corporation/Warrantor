<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the macOS hardened runtime.

  Inert today: `electron-builder.config.cjs` sets `mac.hardenedRuntime: false` explicitly while the
  build is only ad-hoc signed, so nothing reads this file. (The explicit `false` matters —
  electron-builder's default for a non-MAS build is hardened-runtime ON, and ad-hoc signing under
  the hardened runtime would demand `com.apple.security.cs.disable-library-validation`, which is
  granted here to nothing and must stay that way.) This file exists now so that enabling
  notarisation later really is the config change SIGNING.md promises, rather than a change plus a
  file nobody remembered was needed.

  Both entries are required by Electron itself under the hardened runtime — V8 compiles JavaScript
  to machine code at runtime, and a hardened process cannot do that without them. Nothing else is
  granted: the renderer is sandboxed with no preload, so it needs no file, network, camera or
  microphone entitlement, and an entitlement granted because it was in a template is an entitlement
  an attacker inherits.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
