{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantor.io/specs/agent-manifest/v1/agent-manifest.schema.json",
  "title": "Warrantor Agent Manifest (agent.yaml) v1",
  "description": "The OpenAPI for agents. See specs/warrantor-v4/16-agent-manifest.md.",
  "type": "object",
  "required": ["apiVersion", "kind", "name", "identity", "capabilities", "policy_refs", "enforcement_mode"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "type": "string", "const": "agent.warrantor.io/v1" },
    "kind": { "type": "string", "const": "AgentManifest" },
    "name": { "type": "string", "minLength": 1, "maxLength": 253 },
    "identity": {
      "type": "string",
      "pattern": "^spiffe://[^/]+/.*$",
      "description": "Canonical SPIFFE ID. Immutable across a manifest lineage."
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["read", "write", "financial", "destructive", "physical"] },
      "description": "Side-effect classes the agent may use (invariant I-08 ladder). Ceiling, not floor."
    },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "IDs of Cedar/Rego policies that bind the agent."
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "pattern": "^[a-z0-9]+:[a-f0-9]+$", "description": "Weight digest, e.g. sha256:1a2b..." },
        "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "data":  { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "attestation": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Required runtime attesters: tee:sev-snp, tee:tdx, gpu:nras, rim:<algo>:<hex>, svid:spiffe."
    },
    "enforcement_mode": { "enum": ["observed", "mediated"] },
    "description": { "type": "string", "maxLength": 4096 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "Manifest's own semver." }
  }
}
