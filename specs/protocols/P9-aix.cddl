; Generated by tools/protocols/generate.py; do not edit.
; P9 - Agent Incident Exchange; JSON profile has equivalent shape.
aix_envelope = {
  protocol: "P9",
  version: "1.0.0",
  message_id: tstr,
  issuer: tstr,
  issued_at: uint,
  expires_at: uint,
  nonce: tstr .regexp "^[0-9a-f]{64}$",
  payload: aix_payload,
  critical_extensions: [* tstr],
  extensions: { * tstr => any },
  signature: Signature,
}

aix_payload = {
  incident_type: "goal_hijack" / "memory_poisoning" / "tool_abuse" / "identity_compromise" / "exfiltration" / "rogue_delegation",
  severity: "info" / "low" / "medium" / "high" / "critical",
  agent: tstr .regexp "^spiffe://[^\\s]+$",
  authority_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  evidence_refs: [+ tstr],
  mitre_atlas_ids: [* tstr .regexp "^AML\\.T[0-9]{4}(\\.[0-9]{3})?$"],
  ocsf_class_uid: uint,
  detected_at: uint,
  contained_at: uint,
  containment_status: "open" / "contained" / "eradicated" / "recovered",
}

Signature = {
  algorithm: "Ed25519",
  key_id: tstr .regexp "^[A-Za-z0-9._:/-]{1,160}$",
  value: tstr .regexp "^[0-9a-f]{128}$",
}

ArtifactReference = {
  uri: tstr .regexp "^(https|oci|urn|file):[^\\s]+$",
  digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  media_type: tstr,
  version: tstr,
  license: tstr,
}

Budget = {
  steps: uint,
  wall_clock_seconds: uint,
  tokens: uint,
  money_minor: uint,
  external_calls: uint,
  data_bytes: uint,
  irreversible_actions: uint,
}

PolicyDecision = {
  engine: "opa" / "cedar" / "openshell",
  decision: "allow" / "deny",
  policy_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  matched_rules: [* tstr],
}

DeterministicCheck = {
  name: tstr,
  passed: bool,
  detail_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
}

Transformation = {
  operation: tstr,
  implementation: tstr,
  input_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  output_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  applied_at: uint,
}

EvaluationAssertion = {
  name: tstr,
  expected_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  actual_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  passed: bool,
}

NetworkPolicy = {
  egress_default: "deny" / "allow",
  allowlist: [* tstr],
  blocklist: [* tstr],
  dns_policy: "deny" / "allowlisted",
}
