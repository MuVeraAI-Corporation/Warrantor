{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.warrantor.dev/protocols/v1/made.schema.json",
  "title": "AumOS P10 Multi-Agent Delegation Exchange v1 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "message_id",
    "issuer",
    "issued_at",
    "expires_at",
    "nonce",
    "payload",
    "critical_extensions",
    "extensions",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "P10"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "issuer": {
      "type": "string",
      "pattern": "^(spiffe|https|urn):[^\\s]+$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegator",
        "delegatee",
        "parent_authority_digest",
        "delegation_chain",
        "hop_count",
        "max_depth",
        "capabilities",
        "parent_budget",
        "delegated_budget",
        "quorum",
        "approvals",
        "evidence_requirements",
        "result_digest",
        "status"
      ],
      "properties": {
        "delegator": {
          "type": "string",
          "pattern": "^spiffe://[^\\s]+$"
        },
        "delegatee": {
          "type": "string",
          "pattern": "^spiffe://[^\\s]+$"
        },
        "parent_authority_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "delegation_chain": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^spiffe://[^\\s]+$"
          },
          "minItems": 2
        },
        "hop_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "parent_budget": {
          "$ref": "#/$defs/Budget"
        },
        "delegated_budget": {
          "$ref": "#/$defs/Budget"
        },
        "quorum": {
          "type": "integer",
          "minimum": 0
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^spiffe://[^\\s]+$"
          },
          "uniqueItems": true
        },
        "evidence_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "result_digest": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "offered",
            "accepted",
            "completed",
            "rejected",
            "revoked"
          ]
        }
      }
    },
    "critical_extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "signature": {
      "$ref": "#/$defs/Signature"
    }
  },
  "$defs": {
    "Signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,160}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    },
    "ArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "digest",
        "media_type",
        "version",
        "license"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^(https|oci|urn|file):[^\\s]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 3
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "wall_clock_seconds",
        "tokens",
        "money_minor",
        "external_calls",
        "data_bytes",
        "irreversible_actions"
      ],
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "wall_clock_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "money_minor": {
          "type": "integer",
          "minimum": 0
        },
        "external_calls": {
          "type": "integer",
          "minimum": 0
        },
        "data_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "irreversible_actions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PolicyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "decision",
        "policy_digest",
        "matched_rules"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "opa",
            "cedar",
            "openshell"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ]
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "matched_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "DeterministicCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "passed",
        "detail_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "detail_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "Transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "implementation",
        "input_digest",
        "output_digest",
        "applied_at"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "input_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "output_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "applied_at": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "EvaluationAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expected_digest",
        "actual_digest",
        "passed"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expected_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "actual_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "NetworkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "egress_default",
        "allowlist",
        "blocklist",
        "dns_policy"
      ],
      "properties": {
        "egress_default": {
          "type": "string",
          "enum": [
            "deny",
            "allow"
          ]
        },
        "allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blocklist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dns_policy": {
          "type": "string",
          "enum": [
            "deny",
            "allowlisted"
          ]
        }
      }
    }
  }
}
