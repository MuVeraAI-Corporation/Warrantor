; Generated by tools/protocols/generate.py; do not edit.
; P2 - Agent Action Receipt; JSON profile has equivalent shape.
aar_envelope = {
  protocol: "P2",
  version: "1.0.0",
  message_id: tstr,
  issuer: tstr,
  issued_at: uint,
  expires_at: uint,
  nonce: tstr .regexp "^[0-9a-f]{64}$",
  payload: aar_payload,
  critical_extensions: [* tstr],
  extensions: { * tstr => any },
  signature: Signature,
}

aar_payload = {
  phase: "precommit" / "final",
  actor: tstr .regexp "^spiffe://[^\\s]+$",
  authority_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  artifact_digests: [* tstr .regexp "^sha256:[0-9a-f]{64}$"],
  context_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  policy_decision: PolicyDecision,
  operation: tstr,
  checks: [+ DeterministicCheck],
  approvers: [* tstr .regexp "^spiffe://[^\\s]+$"],
  outcome: "pending" / "committed" / "rolled_back" / "failed",
  rollback_pointer: tstr,
  parent_receipt: tstr,
}

Signature = {
  algorithm: "Ed25519",
  key_id: tstr .regexp "^[A-Za-z0-9._:/-]{1,160}$",
  value: tstr .regexp "^[0-9a-f]{128}$",
}

ArtifactReference = {
  uri: tstr .regexp "^(https|oci|urn|file):[^\\s]+$",
  digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  media_type: tstr,
  version: tstr,
  license: tstr,
}

Budget = {
  steps: uint,
  wall_clock_seconds: uint,
  tokens: uint,
  money_minor: uint,
  external_calls: uint,
  data_bytes: uint,
  irreversible_actions: uint,
}

PolicyDecision = {
  engine: "opa" / "cedar" / "openshell",
  decision: "allow" / "deny",
  policy_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  matched_rules: [* tstr],
}

DeterministicCheck = {
  name: tstr,
  passed: bool,
  detail_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
}

Transformation = {
  operation: tstr,
  implementation: tstr,
  input_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  output_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  applied_at: uint,
}

EvaluationAssertion = {
  name: tstr,
  expected_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  actual_digest: tstr .regexp "^sha256:[0-9a-f]{64}$",
  passed: bool,
}

NetworkPolicy = {
  egress_default: "deny" / "allow",
  allowlist: [* tstr],
  blocklist: [* tstr],
  dns_policy: "deny" / "allowlisted",
}
