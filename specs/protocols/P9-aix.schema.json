{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muveraai.com/schemas/protocols/v1/aix.schema.json",
  "title": "Warrantor P9 Agent Incident Exchange v1 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "message_id",
    "issuer",
    "issued_at",
    "expires_at",
    "nonce",
    "payload",
    "critical_extensions",
    "extensions",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "P9"
    },
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "issuer": {
      "type": "string",
      "pattern": "^(spiffe|https|urn):[^\\s]+$"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_type",
        "severity",
        "agent",
        "authority_digest",
        "evidence_refs",
        "mitre_atlas_ids",
        "ocsf_class_uid",
        "detected_at",
        "contained_at",
        "containment_status"
      ],
      "properties": {
        "incident_type": {
          "type": "string",
          "enum": [
            "goal_hijack",
            "memory_poisoning",
            "tool_abuse",
            "identity_compromise",
            "exfiltration",
            "rogue_delegation"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "agent": {
          "type": "string",
          "pattern": "^spiffe://[^\\s]+$"
        },
        "authority_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "mitre_atlas_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^AML\\.T[0-9]{4}(\\.[0-9]{3})?$"
          },
          "uniqueItems": true
        },
        "ocsf_class_uid": {
          "type": "integer",
          "minimum": 1
        },
        "detected_at": {
          "type": "integer",
          "minimum": 0
        },
        "contained_at": {
          "type": "integer",
          "minimum": 0
        },
        "containment_status": {
          "type": "string",
          "enum": [
            "open",
            "contained",
            "eradicated",
            "recovered"
          ]
        }
      }
    },
    "critical_extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "signature": {
      "$ref": "#/$defs/Signature"
    }
  },
  "$defs": {
    "Signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,160}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    },
    "ArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "digest",
        "media_type",
        "version",
        "license"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^(https|oci|urn|file):[^\\s]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 3
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "wall_clock_seconds",
        "tokens",
        "money_minor",
        "external_calls",
        "data_bytes",
        "irreversible_actions"
      ],
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "wall_clock_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "money_minor": {
          "type": "integer",
          "minimum": 0
        },
        "external_calls": {
          "type": "integer",
          "minimum": 0
        },
        "data_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "irreversible_actions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "PolicyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "decision",
        "policy_digest",
        "matched_rules"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "opa",
            "cedar",
            "openshell"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ]
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "matched_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "DeterministicCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "passed",
        "detail_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "detail_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "Transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "implementation",
        "input_digest",
        "output_digest",
        "applied_at"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "input_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "output_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "applied_at": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "EvaluationAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expected_digest",
        "actual_digest",
        "passed"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expected_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "actual_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "NetworkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "egress_default",
        "allowlist",
        "blocklist",
        "dns_policy"
      ],
      "properties": {
        "egress_default": {
          "type": "string",
          "enum": [
            "deny",
            "allow"
          ]
        },
        "allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blocklist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dns_policy": {
          "type": "string",
          "enum": [
            "deny",
            "allowlisted"
          ]
        }
      }
    }
  }
}
