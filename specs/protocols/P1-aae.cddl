; P1 — Agent Authority Envelope (AAE) — CDDL schema
; Normative, machine-readable. Mirrors proto/aumos/identity/v1/agent.proto::AgentAuthorityEnvelope.
; A reference validator (Rust) is provided in rust/authority-spec. See specs/protocols/P1-aae.md.

aae = {
  issuer: tstr,                  ; SPIFFE ID of the issuer
  subject: tstr,                 ; SPIFFE ID of the subject agent
  purpose: tstr,                 ; human-readable purpose
  resources: [* tstr],           ; URIs the agent may touch
  tools: [* tstr],               ; tool SPIFFE IDs the agent may invoke
  data_classes: [* tstr],        ; L0..L4 per cross-cutting 17
  side_effect_class: tstr,       ; read|write|financial|destructive|physical
  spend_budget: int,             ; minor currency units
  time_budget_seconds: int,
  token_budget: int,
  geography: tstr,               ; ISO-3166 alpha-2, "" = unrestricted
  delegation_depth: uint,        ; 0 = no further delegation
  approvals: [* tstr],           ; required approver SPIFFE IDs
  expiry: epoch_time,            ; after this, invalid
  revocation_handle: tstr,       ; opaque; published to revoke
  signature: bstr,               ; Ed25519 signature over canonical-CBOR of the above
}

epoch_time = uint                ; seconds since 1970-01-01T00:00:00Z
