{
  "name": "warrantor",
  "displayName": "AumOS",
  "description": "Syntax highlighting and language support for AumOS configuration files (.complygate.yml, OPA Rego, CDDL)",
  "version": "1.0.0",
  "publisher": "MuVeraAI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MuVeraAI-Corporation/Warrantor"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "ai-security",
    "compliance",
    "opa",
    "rego",
    "cddl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "complygate",
        "aliases": [
          "ComplyGate",
          "complygate"
        ],
        "extensions": [
          ".complygate.yml",
          ".complygate.yaml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cddl",
        "aliases": [
          "CDDL",
          "Concise Data Definition Language"
        ],
        "extensions": [
          ".cddl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "complygate",
        "scopeName": "source.complygate",
        "path": "./syntaxes/complygate.tmLanguage.json"
      },
      {
        "language": "cddl",
        "scopeName": "source.cddl",
        "path": "./syntaxes/cddl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/complygate.json"
      }
    ]
  }
}
