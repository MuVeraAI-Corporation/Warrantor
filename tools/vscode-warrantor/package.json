{
  "name": "warrantor",
  "displayName": "AumOS",
  "description": "Syntax highlighting and language support for AumOS configuration files (.complygate.yml, OPA Rego, CDDL, .aumos/)",
  "version": "1.0.0",
  "publisher": "MuVeraAI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MuVeraAI/aumos"
  },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages", "Linters", "Snippets"],
  "keywords": ["ai-security", "compliance", "opa", "rego", "cddl", "eu-ai-act"],
  "icon": "icon.png",
  "contributes": {
    "languages": [
      {
        "id": "complygate",
        "aliases": ["ComplyGate", "complygate"],
        "extensions": [".complygate.yml", ".complygate.yaml"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "cddl",
        "aliases": ["CDDL", "Concise Data Definition Language"],
        "extensions": [".cddl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "complygate",
        "scopeName": "source.complygate",
        "path": "./syntaxes/complygate.tmLanguage.json"
      },
      {
        "language": "cddl",
        "scopeName": "source.cddl",
        "path": "./syntaxes/cddl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/complygate.json"
      }
    ],
    "commands": [
      {
        "command": "warrantor.installComponent",
        "title": "AumOS: Install Component"
      },
      {
        "command": "warrantor.complianceReport",
        "title": "AumOS: Generate Compliance Report"
      },
      {
        "command": "warrantor.scanSecrets",
        "title": "AumOS: Scan for Exposed Secrets"
      },
      {
        "command": "warrantor.init",
        "title": "AumOS: Initialize Project"
      }
    ],
    "configuration": {
      "title": "AumOS",
      "properties": {
        "warrantor.defstackPath": {
          "type": "string",
          "default": "defstack",
          "description": "Path to the defstack CLI binary"
        },
        "warrantor.autoScanSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan files for exposed secrets on save"
        }
      }
    }
  }
}
